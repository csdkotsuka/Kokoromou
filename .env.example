# ========================================================
# ココロモウ (Kokoromou) 環境変数設定テンプレート
# ========================================================

# Base URL (ローカル開発: http://localhost:3000, 本番: https://your-domain.vercel.app)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --------------------------------------------------------
# 1. Stripe 設定 (Stripe Dashboard -> Developers -> API keys)
# --------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_51...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51...

# Stripe Webhook Secret (stripe listen --forward-to localhost:3000/api/webhook/stripe)
STRIPE_WEBHOOK_SECRET=whsec_...

# --------------------------------------------------------
# 2. Firebase Client SDK 設定 (Firebase Console -> Project Settings)
# --------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=kokoromou-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=kokoromou-app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=kokoromou-app.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# --------------------------------------------------------
# 3. Firebase Admin SDK 設定 (Firebase Console -> Service Accounts)
# --------------------------------------------------------
FIREBASE_PROJECT_ID=kokoromou-app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@kokoromou-app.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
